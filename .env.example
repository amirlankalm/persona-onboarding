# ─── Speko Voice (required for live phone-call UI) ───────────────────────────
# Get from console.speko.ai
SPEKO_API_KEY=
SPEKO_AGENT_ID=
# Signing secret configured on each webhook tool in the Speko Agent dashboard
SPEKO_WEBHOOK_SECRET=

# ─── Groq LLM (required for intelligent text conversation) ───────────────────
# Get from console.groq.com — free tier is generous
GROQ_API_KEY=

# ─── App URL (optional, defaults to localhost:3000) ───────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
